# Copy to .env and adjust. See README.md → Configuration.

# --- Infra credentials (used by docker-compose) ---
POSTGRES_DB=resume_ai
POSTGRES_USER=resume_ai
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=resume_ai
RABBITMQ_PASSWORD=change-me
S3_ACCESS_KEY=resume_ai
S3_SECRET_KEY=change-this-secret

# --- App connections ---
# Host-side values for local development. docker-compose rewrites these
# hostnames for the containers, so the same file works in both setups.
DATABASE_URL=postgresql+asyncpg://resume_ai:change-me@localhost:5432/resume_ai
RABBITMQ_URL=amqp://resume_ai:change-me@localhost:5672/
QDRANT_URL=http://localhost:6333
# host:port only, no http:// (MinIO client requirement)
S3_ENDPOINT_URL=localhost:9000
S3_BUCKET=resumes

# --- Model servers (OpenAI-compatible) ---
AI_LLM_BASE_URL=http://localhost:8080/v1
AI_RESUME_EXTRACTION_MODEL=resume-extractor
AI_LLM_TIMEOUT=1200
AI_EMBEDDING_BASE_URL=http://localhost:8081/v1
AI_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_DIMENSIONS=768
AI_EMBEDDING_TIMEOUT=1200
# Optional smaller models for the cheap tasks (empty = use AI_RESUME_EXTRACTION_MODEL)
AI_QUERY_PARSING_MODEL=
AI_CANDIDATE_EVALUATION_MODEL=

# --- Search tuning ---
SEARCH_MIN_MATCH_SCORE=60
SEARCH_SHORTLIST_SIZE=10
SEARCH_RETRIEVAL_LIMIT=200
SEARCH_EVALUATION_CONCURRENCY=1

# --- Profile research ---
# Optional; raises the GitHub API limit from 60 to 5000 requests/hour
GITHUB_TOKEN=
